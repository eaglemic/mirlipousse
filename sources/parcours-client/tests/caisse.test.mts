import {publicProductId,publicVariantId} from '../app/lib/public-identities.mjs';
import test from 'node:test';
import assert from 'node:assert/strict';
import {readQuote,readCheckoutPreparation,canPrepareCheckout,CommerceError,beginAttempt,api} from '../app/commerce-client';
const id='e7806561-e0d2-45d6-a539-f83753c2996d',item={id:publicProductId('cj-fixture')!,variantId:publicVariantId('vid-fixture')!,quantity:1};
const catalogue={salesEnabled:true,products:[{id:item.id,variants:[{id:item.variantId,label:'Fictif',availableForCheckout:true}]}],deliveryMethods:[{mode:'home' as const,service:'standard' as const,countries:['FR','BE'],availableForPreview:true,qualifiedForCheckout:false}]};
const quote={ok:true,salesEnabled:true,previewOnly:true,canPrepareCheckout:true,country:'FR',currency:'EUR',subtotalIndicativeCents:1000,shippingIndicativeCents:null,totalIndicativeCents:null,items:[{...item,unitIndicativeCents:1000,lineIndicativeCents:1000}],delivery:{mode:'home',service:'standard',qualifiedForCheckout:false,availableForPreview:true}};
const final={ok:true,status:'quoted',previewOnly:false,qualifiedForCheckout:true,orderToken:id,quoteToken:'opaque.fixture-local-only',expiresAt:200000,currency:'EUR',subtotalCents:1000,shippingCents:399,amountCents:1399,delivery:{mode:'home',service:'standard',country:'FR'}};
test('le formulaire se débloque sans exiger livraison finale avant adresse',()=>{const q=readQuote(quote,'FR','home',[item]);assert.equal(canPrepareCheckout(catalogue,q,[item],'FR'),true);assert.equal(canPrepareCheckout(catalogue,q,[{...item,id:'ancien-fixture'}],'FR'),false);});
test('fermeture, admission absente, variante et pays inconnus ne collectent rien',()=>{const q=readQuote(quote,'FR','home',[item]);assert.equal(canPrepareCheckout({...catalogue,salesEnabled:false},q,[item],'FR'),false);assert.equal(canPrepareCheckout(catalogue,{...q,canPrepareCheckout:undefined},[item],'FR'),false);assert.equal(canPrepareCheckout(catalogue,{...q,canPrepareCheckout:false},[item],'FR'),false);assert.equal(canPrepareCheckout(catalogue,q,[{...item,variantId:'autre'}],'FR'),false);assert.equal(canPrepareCheckout(catalogue,q,[item],'BE'),false);assert.throws(()=>readQuote({...quote,canPrepareCheckout:'true'},'FR','home'),CommerceError);});
test('devis final lié à la tentative et au pays, montant exact sans champ client',()=>{assert.equal(readCheckoutPreparation(final,id,'FR',100000).status,'quoted');for(const mutation of [{orderToken:'autre'},{currency:'USD'},{previewOnly:true},{qualifiedForCheckout:false},{amountCents:1400},{shippingCents:null},{expiresAt:100000},{quoteToken:''},{delivery:{...final.delivery,country:'BE'}}])assert.throws(()=>readCheckoutPreparation({...final,...mutation},id,'FR',100000),CommerceError);});
test('l’ancien suivi pending/uncertain est accepté sans créer un second devis',()=>{const order={ok:true,orderToken:id,reference:'fixture_only',status:'pending',paymentStatus:'pending',paid:false,amountCents:1399,currency:'EUR',supplierStatus:'not_requested',delivery:{mode:'home',service:'standard',country:'FR'},supportRequired:false};assert.equal(readCheckoutPreparation(order,id,'FR').status,'pending');assert.equal(readCheckoutPreparation({...order,status:'uncertain',paymentStatus:'uncertain'},id,'FR').status,'uncertain');});
test('préparation et confirmation réutilisent UUID/Bearer ; aucun devis ou PII en stockage',async()=>{const values=new Map<string,string>();Object.defineProperty(globalThis,'localStorage',{value:{getItem:(k:string)=>values.get(k)||null,setItem:(k:string,v:string)=>values.set(k,v),removeItem:(k:string)=>values.delete(k)},configurable:true});const a=beginAttempt(),b=beginAttempt();assert.equal(a.orderToken,b.orderToken);const calls:any[]=[];const previous=globalThis.fetch;globalThis.fetch=async(url:any,options:any)=>{calls.push({url,options});return new Response(JSON.stringify({ok:true}),{status:200});};try{await api('/api/checkout/preparation',{orderToken:a.orderToken,items:[item],contact:{email:'fictif@example.invalid'},shippingAddress:{province:'Région fictive'}},a.accessToken);await api('/api/checkout',{orderToken:a.orderToken,quoteToken:final.quoteToken,consentTerms:true,termsVersion:'mirlipousse-conditions-v1'},a.accessToken);assert.equal(calls[0].options.headers.Authorization,calls[1].options.headers.Authorization);assert.deepEqual(Object.keys(JSON.parse(calls[1].options.body)).sort(),['consentTerms','orderToken','quoteToken','termsVersion']);for(const [key,value] of values){assert.ok(!value.includes('opaque')&&!value.includes('fictif')&&!value.includes('province'));if(!key.endsWith('.active'))assert.ok(JSON.parse(value).every((v:any)=>Object.keys(v).sort().join(',')==='accessToken,createdAt,orderToken'));}}finally{globalThis.fetch=previous;}});
