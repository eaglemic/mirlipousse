import test from 'node:test';
import assert from 'node:assert/strict';
import {isCatalogueExcluded} from '../app/catalogue-exclusions.ts';
import {restoreCart,restoreFavorites} from '../app/cart-state.ts';
import {products} from '../app/lib/catalogue.ts';
import policy from '../app/lib/catalogue-exclusions.json';
const blocked=policy.entries[0];const aliases=policy.entries.flatMap(entry=>[entry.id,...entry.variantIds]);
test('Les articles retirés sont exclus par identifiant boutique et variantes opaques',()=>{for(const id of aliases)assert.equal(isCatalogueExcluded(id),true);assert.equal(isCatalogueExcluded({name:'Nouveau nom',id:blocked.id}),true);assert.equal(isCatalogueExcluded({id:'unrelated',variantId:blocked.variantIds[0]}),true);assert.equal(isCatalogueExcluded(null),false);assert.equal(isCatalogueExcluded('unrelated-reference'),false);});
test('Le catalogue conserve le thermique, retire le pull et ne filtre pas par nom',()=>{assert.equal(isCatalogueExcluded({id:'autre-jouet-poisson',name:'Jouet poisson'}),false);assert.equal(products.length,30);assert.equal(products.some(p=>p.id==='mm-p-3a2083c3a6856ddc2b8801a954374a70948305d8029d14519e759db405de9b21'),false);assert.equal(products.some(p=>p.id==='mm-p-41f5e7627e3575f06b31b2db676cd8a12cac15ddd56999167f75b7ea4f304624'),true);assert.equal(products.some(p=>isCatalogueExcluded(p)),false);});
test('Un ancien panier ne réaffiche pas la trousse bannie comme référence inconnue',()=>{const other=products[0];const rows=[...aliases.map(id=>({id,quantity:1})),{id:other.id,quantity:2},{id:'ancienne-reference-inconnue',quantity:3}];const restored=restoreCart(rows,products);assert.deepEqual(restored.lines,[{id:other.id,variantId:other.defaultVariantId,quantity:2}]);assert.deepEqual(restored.unresolved,[{id:'ancienne-reference-inconnue',quantity:3}]);});
test('Les favoris suppriment seulement la référence bannie et gardent les autres choix',()=>{const other=products[0];assert.deepEqual(restoreFavorites([...aliases,other.id,other.id,'ancien-favori-inconnu'],products),[other.id,'ancien-favori-inconnu']);assert.deepEqual(restoreFavorites(null,products),[]);});
