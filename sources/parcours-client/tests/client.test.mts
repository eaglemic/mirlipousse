import {publicProductId,publicVariantId} from '../app/lib/public-identities.mjs';
import test from 'node:test';
import assert from 'node:assert/strict';
import {restoreCart,aliases} from '../app/cart-state.ts';
import {products} from '../app/lib/catalogue.ts';
import {api,readCatalogue,readQuote,readPickups,readOrder,paymentURL,newAttempt,beginAttempt,finishAttempt,attempts,validAccess,euros,CommerceError} from '../app/commerce-client.ts';
const id='e7806561-e0d2-45d6-a539-f83753c2996d';
test('Les30 identifiants publics et leurs quantites sont repris',()=>{assert.equal(products.length,31);const original=products.map((p,i)=>({id:p.id,quantity:i%3+1}));const restored=restoreCart(original,products);assert.equal(restored.lines.length,31);assert.equal(restored.unresolved.length,0);for(const [i,line] of restored.lines.entries()){assert.equal(line.id,products[i].id);assert.equal(line.variantId,products[i].defaultVariantId);assert.equal(line.quantity,original[i].quantity);}});
test('Les anciens alias sont migrés sans table de références privées dans le client',()=>{const p={...products[0],id:publicProductId('cj-fixture-produit')!,defaultVariantId:publicVariantId('fixture-variante')!,variants:undefined};for(const id of ['cj-fixture-produit','mirlipousse-cj-fixture-produit']){assert.equal(aliases([p]).get(id)?.id,p.id);assert.equal(restoreCart([{id,variantId:'fixture-variante',quantity:2}],[p]).lines[0].id,p.id);assert.equal(restoreCart([{id,variantId:'fixture-variante',quantity:2}],[p]).lines[0].variantId,p.defaultVariantId);}});
test('Ancienne reference inconnue et ancienne variante ne sont pas remplacees',()=>{const r=restoreCart([{id:'ancien-hors-catalogue',quantity:3},{id:products[0].id,variantId:'ancienne-variante-fictive',quantity:2}],products);assert.equal(r.unresolved[0].id,'ancien-hors-catalogue');assert.equal(r.unresolved[0].quantity,3);assert.equal(r.lines[0].variantId,'ancienne-variante-fictive');});
test('Les quantites sont bornees sans prise de prix client',()=>{const r=restoreCart([{id:products[0].id,quantity:1,priceCents:1},{id:products[0].id,quantity:2},{id:products[1].id,quantity:99}],products);assert.equal(r.lines.length,1);assert.equal(r.lines[0].quantity,3);assert.equal('priceCents' in r.lines[0],false);});
const catalogue={ok:true,brand:'mirlipousse',salesEnabled:false,products:[{id:products[0].id,variants:[{id:products[0].defaultVariantId,label:'Variante fictive',priceCents:2190,priceStatus:'fixed',priceIncludesShipping:false,availableForCheckout:false}]}],deliveryMethods:[{mode:'home',service:'standard',countries:['FR','BE'],availableForPreview:true,qualifiedForCheckout:false}]};
test('Catalogue ferme explicite et methodes qualifiees uniquement',()=>{assert.equal(readCatalogue(catalogue).salesEnabled,false);for(const salesEnabled of [undefined,null,'true'])assert.throws(()=>readCatalogue({...catalogue,salesEnabled}),CommerceError);assert.throws(()=>readCatalogue({...catalogue,deliveryMethods:[{...catalogue.deliveryMethods[0],service:'express'}]}),CommerceError);});
const quote={ok:true,salesEnabled:false,previewOnly:true,country:'FR',currency:'EUR',subtotalIndicativeCents:null,shippingIndicativeCents:null,totalIndicativeCents:null,delivery:{mode:'home',service:'standard',qualifiedForCheckout:false,availableForPreview:true}};
test('Devis sans cout reste null, jamais gratuit ni qualifie implicitement',()=>{assert.equal(readQuote(quote,'FR','home').shippingIndicativeCents,null);assert.equal(euros(null),'À confirmer');assert.throws(()=>readQuote({...quote,country:'BE'},'FR','home'),CommerceError);assert.throws(()=>readQuote({...quote,delivery:{...quote.delivery,qualifiedForCheckout:undefined}},'FR','home'),CommerceError);});
test('Relais indisponible sans faux points, pays et prestataire verifies',()=>{assert.deepEqual(readPickups({ok:true,available:false,points:[]},'FR'),[]);const point={id:'fixture-id',provider:'fixture-provider',name:'Relais fictif',addressLine1:'12 rue Fictive',postalCode:'75001',city:'Paris',country:'FR'};assert.equal(readPickups({ok:true,available:true,points:[point]},'FR')[0].id,'fixture-id');assert.throws(()=>readPickups({ok:true,available:false,points:[point]},'FR'),CommerceError);assert.throws(()=>readPickups({ok:true,available:true,points:[point]},'BE'),CommerceError);assert.throws(()=>readPickups({ok:true,available:true,points:[{...point,provider:''}]},'FR'),CommerceError);});
test('Seule URL SumUp HTTPS verifiee est ouverte',()=>{assert.ok(paymentURL('https://checkout.sumup.com/pay/'+id));for(const url of ['https://evil.invalid/pay/'+id,'http://checkout.sumup.com/pay/'+id,'https://checkout.sumup.com.evil.invalid/pay/'+id,'https://name@checkout.sumup.com/pay/'+id,'https://checkout.sumup.com/pay/'+id+'?token=interdit','https://checkout.sumup.com/pay/'+'-'.repeat(36),'javascript:alert(1)'])assert.equal(paymentURL(url),null);});
test('Acces de reprise aleatoire durable avant POST, sans adresse ou secret en URL',()=>{const values=new Map<string,string>();Object.defineProperty(globalThis,'localStorage',{value:{getItem:(k:string)=>values.get(k)||null,setItem:(k:string,v:string)=>values.set(k,v)},configurable:true});const a=newAttempt(),b=newAttempt();assert.equal(validAccess(a.orderToken,a.accessToken),true);assert.notEqual(a.accessToken,b.accessToken);assert.equal(attempts().length,2);for(const value of values.values()){const data=JSON.parse(value);assert.ok(data.every((x:any)=>Object.keys(x).sort().join(',')==='accessToken,createdAt,orderToken'));assert.equal(value.includes('email'),false);}});
test('Stockage refuse empeche creation de tentative payante',()=>{Object.defineProperty(globalThis,'localStorage',{value:{getItem:()=>null,setItem:()=>{throw Error('fixture');}},configurable:true});assert.throws(()=>newAttempt(),(e:any)=>e.code==='STORAGE_UNAVAILABLE');});
const order={ok:true,orderToken:id,reference:'mp_fixture',status:'pending',paymentStatus:'pending',paid:false,amountCents:4300,currency:'EUR',supplierStatus:'not_requested',delivery:{mode:'home',service:'standard',country:'FR'},supportRequired:false,paymentUrl:'https://checkout.sumup.com/pay/'+id};
test('Le suivi exige etat serveur coherent, pas un parametre paid',()=>{assert.equal(readOrder(order,id).paid,false);assert.throws(()=>readOrder({...order,paid:true},id),CommerceError);assert.throws(()=>readOrder({...order,orderToken:'autre'},id),CommerceError);assert.throws(()=>readOrder({...order,paymentUrl:'https://evil.invalid'},id),CommerceError);});
test('Le code prive est en Authorization uniquement, jamais URL ou corps',async()=>{const old=globalThis.fetch;let request:any;globalThis.fetch=async(url:any,options:any)=>{request={url,options};return new Response(JSON.stringify(order),{status:200,headers:{'Content-Type':'application/json'}});};try{const fake='x'.repeat(43);await api('/api/commandes/reconciliation',{orderToken:id},fake);assert.equal(request.url.includes(fake),false);assert.equal(request.options.body.includes(fake),false);assert.equal(request.options.headers.Authorization,'Bearer '+fake);assert.equal(request.options.credentials,'omit');assert.equal(request.options.redirect,'error');}finally{globalThis.fetch=old;}});
test('Erreur fermee et reponse malformee ne deviennent pas un succes',async()=>{const old=globalThis.fetch;try{globalThis.fetch=async()=>new Response(JSON.stringify({ok:false,code:'SHOP_NOT_OPEN'}),{status:503});await assert.rejects(()=>api('/api/checkout',{}),(e:any)=>e.code==='SHOP_NOT_OPEN');globalThis.fetch=async()=>new Response('null',{status:200});await assert.rejects(()=>api('/api/boutique/catalogue'),CommerceError);}finally{globalThis.fetch=old;}});

test('Reouverture du formulaire garde la meme tentative tant que non terminee',()=>{const values=new Map<string,string>();Object.defineProperty(globalThis,'localStorage',{value:{getItem:(k:string)=>values.get(k)||null,setItem:(k:string,v:string)=>values.set(k,v),removeItem:(k:string)=>values.delete(k)},configurable:true});const a=beginAttempt(),b=beginAttempt();assert.equal(a.orderToken,b.orderToken);assert.equal(a.accessToken,b.accessToken);finishAttempt(a.orderToken);assert.notEqual(beginAttempt().orderToken,a.orderToken);});
test('Devis refuse un autre contenu de panier meme avec bonnes balises',()=>{const line={id:products[0].id,variantId:products[0].defaultVariantId,quantity:1};assert.throws(()=>readQuote({...quote,items:[{...line,quantity:2,unitIndicativeCents:100,lineIndicativeCents:200}]},'FR','home',[line]),CommerceError);});

test('Reference null uniquement en prepared et checkout UUID generique',()=>{const prepared={...order,status:'prepared',paymentStatus:'prepared',reference:null};delete prepared.paymentUrl;assert.equal(readOrder(prepared,id).reference,null);assert.throws(()=>readOrder({...order,reference:null},id),CommerceError);assert.ok(paymentURL('https://checkout.sumup.com/pay/12345678-1111-1111-1111-123456789012'));});
